DATABASE_URL=postgres://app_user:app_pass@localhost:5432/procure
DATABASE_MIGRATOR_URL=postgres://postgres@localhost:5432/procure
DATABASE_PLATFORM_URL=postgres://platform_user:platform_pass@localhost:5432/procure
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-dev-only-32-bytes-minimum!!
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Files (Phase 2, ADR-0008). Defaults shown; FILE_URL_SECRET is required in production.
STORAGE_DRIVER=local
# STORAGE_DIR=./.data/files
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ENDPOINT=
SCANNER_DRIVER=noop
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
# FILE_URL_SECRET=change-me-32-bytes-minimum-file-url-key
# FILE_URL_BASE=http://localhost:4000
# Notify (Phase 6, ADR-0014). AES-256-GCM key for provider secrets; required in production (dev/test derive one from JWT_SECRET).
# PROVIDER_KEY=change-me-32-bytes-minimum-provider-key
# Audit hash chain (SEC8-015): HMAC-SHA256 key, required in production (dev/test derive one from JWT_SECRET).
# AUDIT_HASH_KEY=change-me-32-bytes-minimum-audit-hash-key
# AUDIT_HASH_KEY_PREVIOUS=
# Where the `log` email/WhatsApp providers write messages (default <repo>/.data/mail/<tenant>/).
# MAIL_LOG_DIR=./.data/mail
# PDF rendering (Phase 6): Chromium for headless PDF; defaults to the first chromium under PLAYWRIGHT_BROWSERS_PATH
PDF_CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
