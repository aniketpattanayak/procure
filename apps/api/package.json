{
  "name": "@procure/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json -w --preserveWatchOutput & node --watch --env-file=../../.env dist/main.js",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:seed": "node --env-file-if-exists=../../.env dist/seed/demo.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.700.0",
    "@aws-sdk/client-sesv2": "3.699.0",
    "@aws-sdk/s3-request-presigner": "3.700.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@node-rs/argon2": "^2.0.0",
    "@procure/formula": "workspace:*",
    "@procure/schema": "workspace:*",
    "bullmq": "5.34.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "7.0.3",
    "decimal.js": "^10.6.0",
    "exceljs": "4.4.0",
    "file-type": "16.5.4",
    "handlebars": "4.7.10",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "jose": "^5.9.0",
    "kysely": "^0.27.4",
    "nodemailer": "10.0.16",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "playwright-core": "1.64.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.35.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.0",
    "@procure/test-kit": "workspace:*",
    "@swc/core": "^1.9.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "6.4.17",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "2.1.9",
    "supertest": "^7.0.0",
    "typescript": "^5.6.0",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.0"
  }
}
